---
// News list rows (Schmidt Ocean's Category | Date format, as on the homepage).
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<ul class="divide-y divide-line border-y border-line">
  {
    posts.map((post) => (
      <li class="py-8">
        <article class="grid gap-3 md:grid-cols-12 md:gap-8">
          <p class="eyebrow text-muted md:col-span-3 md:pt-1">
            {post.category ? (
              <a href={getPermalink(post.category.slug, 'category')} class="hover:text-link hover:underline">
                {post.category.title}
              </a>
            ) : (
              'News'
            )}
            <span aria-hidden="true"> | </span>
            <time datetime={post.publishDate.toISOString()}>{fmt.format(post.publishDate)}</time>
          </p>
          <div class="md:col-span-9">
            <h2 class="text-2xl leading-snug font-bold text-heading">
              <a href={getPermalink(post.permalink, 'post')} class="underline-offset-4 hover:text-link hover:underline">
                {post.title}
              </a>
            </h2>
            {post.excerpt && <p class="mt-2 max-w-3xl text-lg text-muted">{post.excerpt}</p>}
            <a
              href={getPermalink(post.permalink, 'post')}
              class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-link underline-offset-4 hover:underline"
              aria-label={`Read: ${post.title}`}
            >
              Read <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </article>
      </li>
    ))
  }
</ul>
