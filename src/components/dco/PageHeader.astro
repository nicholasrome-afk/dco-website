---
// Navy page header used by every inner page: eyebrow with accent bar, H1, intro.
export interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="bg-abyss">
  <div class="mx-auto max-w-7xl px-4 py-16 md:py-20 lg:px-6">
    <p class="eyebrow-bar text-on-dark-muted before:bg-accent">{eyebrow}</p>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white md:text-6xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg text-on-dark-muted">{intro}</p>}
    <slot />
  </div>
</section>
