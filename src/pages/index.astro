---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import SectionHead from '~/components/dco/SectionHead.astro';
import EventCard from '~/components/dco/EventCard.astro';
import NetworkCard from '~/components/dco/NetworkCard.astro';
import PhotoCredit from '~/components/dco/PhotoCredit.astro';

import { SITE, I18N } from 'astrowind:config';
import { ORG } from '~/config/org';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getEvents, splitByTime, fullDate, timeRange } from '~/utils/events';

import { IMAGES } from '~/config/images';
import networkMap from '~/data/network-map.json';

const metadata = {
  title: `${ORG.name} (${ORG.shortName})`,
  ignoreTitleTemplate: true,
};

// --- Content ----------------------------------------------------------------

const pillars = [
  { word: 'Coordinate', text: 'Connecting the Decade Actions that address Challenge 7.' },
  { word: 'Observe', text: 'Identifying and filling capacity gaps across every ocean basin.' },
  { word: 'Deliver', text: 'Connecting data and its users across silos, for sustainable growth.' },
];

const themes = [
  {
    icon: 'tabler:temperature',
    title: 'Ocean–climate nexus',
    text: 'Sustained observations that underpin climate monitoring, prediction and adaptation.',
  },
  {
    icon: 'tabler:fish',
    title: 'Ecosystems and marine pollution',
    text: 'Fit-for-purpose data to manage marine ecosystems and track pollution.',
  },
  {
    icon: 'tabler:ship',
    title: 'Blue food and ocean economy',
    text: 'Information that supports food from the sea and a sustainable ocean economy.',
  },
  {
    icon: 'tabler:world',
    title: 'GOOS beyond 2030',
    text: 'Lifting observing capacity and leaving a practical legacy for GOOS after the Decade.',
  },
];

const label = (n: { data: { acronym?: string; name: string } }) => n.data.acronym ?? n.data.name;
const network = (await getCollection('network')).sort((a, b) => label(a).localeCompare(label(b)));
const partners = network.filter((n) => n.data.type === 'partner');
const programmes = network.filter((n) => n.data.type === 'programme');

const events = await getEvents();
const { upcoming, past } = splitByTime(events);
const homeEvents = (upcoming.length ? upcoming : past).slice(0, 3);
const spotlight = events.find((e) => e.data.featured);

// Live-data callout under the hero, from the same OceanOPS snapshot as the map.
const mapDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(networkMap.retrieved));
const mapNetworks = networkMap.networks.filter((n) => n.name !== 'Other').slice(0, 3);

const posts = await findLatestPosts({ count: 3 });
const postDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// Structured data built only from config.yaml and src/config/org.ts.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: ORG.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': `${SITE?.site}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE?.site}/#organization`,
    name: ORG.name,
    alternateName: ORG.shortName,
    url: SITE?.site,
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero (MBARI-style large left-aligned type over a live map of the global observing system) -->
  <section class="relative isolate overflow-hidden bg-abyss" aria-labelledby="hero-heading">
    <Image
      src={IMAGES.homeHero.src}
      alt={IMAGES.homeHero.alt}
      layout="none"
      loading="eager"
      fetchpriority="high"
      widths={[768, 1280, 1920, 2880]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover md:object-contain md:object-right"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-r from-abyss/90 via-abyss/55 to-abyss/0" aria-hidden="true"></div>
    <PhotoCredit image={IMAGES.homeHero} />
    <div class="mx-auto max-w-7xl px-4 pt-24 pb-20 md:pt-36 md:pb-28 lg:px-6">
      <p class="eyebrow-bar text-on-dark-muted before:bg-accent">{ORG.name}</p>
      <h1
        id="hero-heading"
        class="mt-5 max-w-4xl text-4xl leading-[1.05] font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl"
      >
        A sustained ocean observing system for every ocean basin.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-on-dark md:text-xl">
        We connect the Decade Actions addressing {ORG.decade.challenge} so that ocean data is accessible, timely and actionable
        for all users.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="#about" class="btn-dco-accent">What we do</a>
        <a href={getPermalink('/events')} class="btn-dco-outline-light">Events</a>
      </div>
      <div class="mt-14 max-w-2xl border-t border-white/15 pt-6">
        <p class="text-on-dark">
          <span class="font-heading text-3xl font-extrabold text-white">{networkMap.total.toLocaleString('en-GB')}</span
          >
          <span class="ml-2">observing platforms reported a position in the 30 days to {mapDate}.</span>
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-on-dark-muted" aria-label="Largest networks">
          {
            mapNetworks.map(({ name, count, color }) => (
              <li class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full" style={{ backgroundColor: color }} aria-hidden="true" />
                {name}: {count.toLocaleString('en-GB')}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Pillar bar (after Schmidt Ocean's INNOVATE | EXPLORE | SHARE) -->
  <section class="border-t border-white/10 bg-abyss" aria-label="Our approach">
    <ul class="mx-auto grid max-w-7xl md:grid-cols-3 lg:px-6">
      {
        pillars.map(({ word, text }, i) => (
          <li
            class:list={[
              'px-4 py-8 md:px-8 md:py-10',
              i > 0 && 'border-t border-white/10 md:border-t-0 md:border-l',
              i === 0 && 'md:pl-0',
            ]}
          >
            <p class="font-heading text-2xl font-extrabold tracking-[0.08em] text-white uppercase md:text-3xl">
              {word}
            </p>
            <p class="mt-2 text-on-dark-muted">{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- About: mission + theme cards (after ONC's "What We Deliver") -->
  <section class="scroll-mt-24 py-16 md:py-24" aria-labelledby="about">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 lg:grid-cols-12 lg:px-6">
      <div class="lg:col-span-5">
        <p class="eyebrow-bar text-muted">What we do</p>
        <h2 id="about" class="mt-3 scroll-mt-28 text-3xl font-bold tracking-tight text-heading md:text-4xl">
          Coordinating {ORG.decade.challenge}
        </h2>
        <p class="mt-6 text-lg text-default">
          {ORG.decade.challenge} calls for a sustainable ocean observing system across all ocean basins that delivers accessible,
          timely and actionable data and information to all users.
        </p>
        <p class="mt-4 text-lg text-muted">
          Hosted by <a class="text-link underline underline-offset-2" href={ORG.host.url}>{ORG.host.name}</a>, DCO-OO
          connects the many Decade Actions working toward that goal, alongside GOOS and partners, so the coordination
          lasts beyond 2030.
        </p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
        {
          themes.map(({ icon, title, text }) => (
            <li class="rounded-[4px] border border-line p-6">
              <Icon name={icon} class="h-8 w-8 text-link" aria-hidden="true" />
              <h3 class="mt-4 text-lg font-bold text-heading">{title}</h3>
              <p class="mt-2 text-muted">{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Spotlight tiles (after Schmidt Ocean's split feature cards) -->
  <section class="bg-mist py-16 md:py-20" aria-label="Spotlight">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 lg:grid-cols-5 lg:px-6">
      {
        spotlight && (
          <article class="grid overflow-hidden rounded-[4px] bg-abyss text-on-dark sm:grid-cols-5 lg:col-span-3">
            <div class="relative min-h-56 sm:col-span-2">
              <Image
                src={IMAGES.spotlight.src}
                alt={IMAGES.spotlight.alt}
                style={`object-position: ${IMAGES.spotlight.position}`}
                layout="cover"
                widths={[400, 800]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 40vw, 100vw"
                class="absolute inset-0 h-full w-full object-cover"
              />
              <PhotoCredit image={IMAGES.spotlight} class="top-2 right-2 left-2 w-fit" />
            </div>
            <div class="flex flex-col p-6 sm:col-span-3 md:p-8">
              <p class="eyebrow text-accent">Spotlight · {spotlight.data.conference} town hall</p>
              <h2 class="mt-3 text-2xl leading-tight font-bold text-white">{spotlight.data.title}</h2>
              <p class="mt-3 text-sm text-on-dark-muted">
                {spotlight.data.organizers.join(', ')} · {fullDate(spotlight.data.date)} · {timeRange(spotlight.data)} ·{' '}
                {spotlight.data.location}
              </p>
              {spotlight.data.link && (
                <a href={spotlight.data.link} class="btn-dco-outline-light mt-6 self-start">
                  View session <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
                </a>
              )}
            </div>
          </article>
        )
      }
      <article class="flex flex-col rounded-[4px] bg-primary p-6 text-white md:p-8 lg:col-span-2">
        <p class="eyebrow text-white">Conference programme</p>
        <h2 class="mt-3 text-2xl leading-tight font-bold">Ocean Sciences Meeting 2026</h2>
        <p class="mt-3 text-white">
          Browse the complete OSM'26 scientific programme, including every session from the Challenge 7 community.
        </p>
        <a
          href="https://agu.confex.com/agu/osm26/meetingapp.cgi"
          class="btn-dco-outline-light mt-6 self-start lg:mt-auto"
        >
          Full programme <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      </article>
    </div>
  </section>

  <!-- Partners and programmes (after ONC's card grid) -->
  <section class="py-16 md:py-24" aria-labelledby="network">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="network"
        eyebrow="Our network"
        title="Partners and programmes"
        intro={`${partners.length} Decade Implementing Partners and ${programmes.length} Decade Challenge 7 Programmes are building ocean observing capacity across every ocean basin.`}
        class="scroll-mt-28"
      />
      <h3 class="eyebrow mt-12 text-muted">Decade Implementing Partners</h3>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          partners.map((item) => (
            <li>
              <NetworkCard item={item} />
            </li>
          ))
        }
      </ul>
      <h3 class="eyebrow mt-12 text-muted">Decade Challenge 7 Programmes</h3>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          programmes.map((item) => (
            <li>
              <NetworkCard item={item} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Events -->
  <section class="bg-mist py-16 md:py-24" aria-labelledby="events">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="events"
        eyebrow="Events"
        title={upcoming.length ? 'Upcoming events' : 'Recent events'}
        intro={upcoming.length ? undefined : 'No upcoming events are listed right now. Here are the most recent.'}
        link={{ text: 'All events', href: getPermalink('/events') }}
        class="scroll-mt-28"
      />
      <ul class="mt-10 grid gap-4">
        {
          homeEvents.map((event) => (
            <li>
              <EventCard event={event} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Updates feed (after Schmidt Ocean's Category | Date list) -->
  {
    posts.length > 0 && (
      <section class="py-16 md:py-24" aria-labelledby="updates">
        <div class="mx-auto max-w-7xl px-4 lg:px-6">
          <SectionHead
            id="updates"
            eyebrow="News"
            title="Latest updates"
            link={{ text: 'All news', href: getPermalink('/news') }}
            class="scroll-mt-28"
          />
          <ul class="mt-10 grid border-t border-line md:grid-cols-3 md:border-t-0">
            {posts.map((post, i) => (
              <li
                class:list={[
                  'border-b border-line py-6 md:border-t-4 md:border-b-0 md:border-t-primary md:pt-6 md:pb-0',
                  i > 0 && 'md:pl-8',
                  i < posts.length - 1 && 'md:pr-8',
                ]}
              >
                <p class="eyebrow text-muted">
                  {post.category?.title ?? 'News'} <span aria-hidden="true">|</span>{' '}
                  <time datetime={post.publishDate.toISOString()}>{postDate.format(post.publishDate)}</time>
                </p>
                <h3 class="mt-3 text-xl leading-snug font-bold text-heading">
                  <a
                    href={getPermalink(post.permalink, 'post')}
                    class="underline-offset-4 hover:text-link hover:underline"
                  >
                    {post.title}
                  </a>
                </h3>
                {post.excerpt && <p class="mt-2 text-muted">{post.excerpt}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
