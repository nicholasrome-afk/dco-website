---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/dco/PageHeader.astro';

import { ORG } from '~/config/org';

const metadata = {
  title: 'Contact',
  description: `Contact the ${ORG.name} Secretariat.`,
};

// Email links open the visitor's own mail app (the old Squarespace form effectively did the same).
const subject = encodeURIComponent(`Enquiry via ${ORG.shortName} website`);
---

<Layout metadata={metadata}>
  <PageHeader
    eyebrow="Contact"
    title="Get in touch"
    intro="If you have any questions or comments, please don’t hesitate to reach out directly via email."
  />

  <section class="py-16 md:py-24" aria-labelledby="secretariat">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <p class="eyebrow-bar text-muted">{ORG.shortName} Secretariat</p>
      <h2 id="secretariat" class="mt-3 text-3xl font-bold tracking-tight text-heading md:text-4xl">
        Email the Secretariat
      </h2>

      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {
          ORG.contacts.map(({ name, email }) => (
            <li class="flex flex-col rounded-[4px] border border-line p-6 md:p-8">
              <p class="font-heading text-2xl font-bold text-heading">{name}</p>
              <p class="mt-1 text-muted">{ORG.shortName} Secretariat</p>
              <p class="mt-4">
                <a href={`mailto:${email}`} class="text-link underline underline-offset-4">
                  {email}
                </a>
              </p>
              <a href={`mailto:${email}?subject=${subject}`} class="btn-dco-primary mt-6 self-start">
                <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" /> Email {name.split(' ')[0]}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-12 max-w-2xl">
        <div class="rounded-[4px] bg-mist p-6 md:p-8">
          <p class="eyebrow text-muted">Hosted by</p>
          <h2 class="mt-2 text-xl font-bold text-heading">{ORG.host.name}</h2>
          <p class="mt-2 text-muted">
            The {ORG.name} is hosted by {ORG.host.name}.
          </p>
          <a
            href={ORG.host.url}
            class="mt-6 inline-flex items-center gap-1.5 font-semibold text-link underline-offset-4 hover:underline"
          >
            Visit the Center for Ocean Leadership <Icon
              name="tabler:arrow-up-right"
              class="h-4 w-4"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
