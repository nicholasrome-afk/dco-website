---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';

import { getCanonical, getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { truncateAtWord } from '~/utils/utils';
import type { MetaData } from '~/types';
import StructuredData from '~/components/common/StructuredData.astro';
import { ORG } from '~/config/org';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, 'post'));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const metadata = merge(
  {
    title: post.title,
    // Search engines cut descriptions at about 155 characters; the full excerpt stays visible on the page.
    description: truncateAtWord(post.excerpt, 155),
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      article: {
        publishedTime: post.publishDate.toISOString(),
        modifiedTime: (post.updateDate ?? post.publishDate).toISOString(),
        ...(post.author ? { authors: [post.author] } : {}),
        ...(post.category ? { section: post.category.title } : {}),
        ...(post.tags?.length ? { tags: post.tags.map((tag) => tag.title) } : {}),
      },
      ...(image
        ? { images: [{ url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height }] }
        : {}),
    },
  },
  { ...(post?.metadata ? { ...post.metadata, canonical: post.metadata?.canonical || url } : {}) }
) as MetaData;

const imageUrl = typeof image === 'string' ? image : image?.src;

// Article structured data. The breadcrumb trail below carries its own BreadcrumbList.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishDate.toISOString(),
  dateModified: (post.updateDate ?? post.publishDate).toISOString(),
  ...(post.author ? { author: { '@type': 'Person', name: post.author } } : {}),
  publisher: { '@type': 'Organization', name: ORG.name },
  ...(imageUrl ? { image: imageUrl.startsWith('http') ? imageUrl : new URL(imageUrl, Astro.site).toString() } : {}),
  ...(post.category ? { articleSection: post.category.title } : {}),
  ...(post.tags?.length ? { keywords: post.tags.map((tag) => tag.title).join(', ') } : {}),
  mainEntityOfPage: String(url),
};

const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={articleSchema} />
  <article>
    <header class="bg-abyss">
      <div class="mx-auto max-w-4xl px-4 py-16 md:py-20 lg:px-6">
        <p class="eyebrow-bar text-on-dark-muted before:bg-accent">
          {
            post.category ? (
              <a href={getPermalink(post.category.slug, 'category')} class="hover:text-on-dark hover:underline">
                {post.category.title}
              </a>
            ) : (
              'News'
            )
          }
          <span aria-hidden="true">|</span>
          <time datetime={post.publishDate.toISOString()}>{date.format(post.publishDate)}</time>
        </p>
        <h1 class="mt-4 text-3xl leading-tight font-extrabold tracking-tight text-white md:text-5xl">{post.title}</h1>
        {post.excerpt && <p class="mt-5 text-lg text-on-dark-muted md:text-xl">{post.excerpt}</p>}
      </div>
    </header>

    {
      image && (
        <div class="mx-auto max-w-4xl px-4 pt-10 lg:px-6">
          <Image
            src={image}
            alt={post.imageAlt || ''}
            widths={[400, 900]}
            sizes="(max-width: 900px) 100vw, 900px"
            width={900}
            height={506}
            class="w-full rounded-[4px]"
          />
        </div>
      )
    }

    <div
      class="prose prose-lg mx-auto max-w-4xl px-4 py-12 prose-headings:font-heading prose-headings:text-heading prose-a:text-link prose-strong:text-heading lg:px-6"
    >
      {post.Content && <post.Content />}
    </div>
  </article>

  <nav class="mx-auto max-w-4xl px-4 pb-20 lg:px-6" aria-label="News">
    <a
      href={getBlogPermalink()}
      class="inline-flex items-center gap-1.5 font-semibold text-link underline-offset-4 hover:underline"
    >
      <Icon name="tabler:arrow-left" class="h-4 w-4" aria-hidden="true" /> All news
    </a>
  </nav>
</Layout>
