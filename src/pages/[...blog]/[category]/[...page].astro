---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/dco/PageHeader.astro';
import NewsList from '~/components/dco/NewsList.astro';
import Pagination from '~/components/blog/Pagination.astro';
import { getBlogPermalink } from '~/utils/permalinks';
import { ORG } from '~/config/org';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `${category.title}${currentPage > 1 ? ` — Page ${currentPage}` : ''} | News`,
  description: `${category.title} from the ${ORG.name}.`,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <PageHeader eyebrow="News" title={category.title}>
    <a href={getBlogPermalink()} class="mt-6 inline-block text-on-dark-link underline-offset-4 hover:underline"
      >All news</a
    >
  </PageHeader>
  <section class="mx-auto max-w-7xl px-4 py-16 md:py-20 lg:px-6">
    <NewsList posts={page.data} />
    <div class="mt-10">
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>
</Layout>
