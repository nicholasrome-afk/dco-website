---
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/dco/PageHeader.astro';
import { getHomePermalink, getPermalink, getBlogPermalink } from '~/utils/permalinks';

const metadata = { title: 'Page not found', robots: { index: false, follow: true } };

const links = [
  { text: 'Home', href: getHomePermalink() },
  { text: 'About', href: getPermalink('/about') },
  { text: 'Events', href: getPermalink('/events') },
  { text: 'News', href: getBlogPermalink() },
  { text: 'Contact', href: getPermalink('/contact') },
];
---

<Layout metadata={metadata}>
  <PageHeader
    eyebrow="Error 404"
    title="Page not found"
    intro="This page doesn't exist, or it moved when the site was rebuilt."
  />
  <section class="mx-auto max-w-7xl px-4 py-16 md:py-20 lg:px-6" aria-labelledby="try">
    <h2 id="try" class="text-2xl font-bold text-heading">Try one of these instead</h2>
    <ul class="mt-6 flex flex-wrap gap-3">
      {
        links.map(({ text, href }) => (
          <li>
            <a href={href} class="btn-dco-primary">
              {text}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
